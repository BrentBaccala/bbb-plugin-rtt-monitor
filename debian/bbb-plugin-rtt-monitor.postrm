#!/bin/bash
set -e

BBB_WEB_PROPS=/etc/bigbluebutton/bbb-web.properties

case "$1" in
    remove|purge)
        if [ -f "$BBB_WEB_PROPS" ]; then
            CURRENT=$(grep -oP '(?<=^pluginManifests=).*' "$BBB_WEB_PROPS" 2>/dev/null || echo "")

            if echo "$CURRENT" | grep -q "rtt-monitor/manifest.json"; then
                NEW=$(echo "$CURRENT" | sed 's#,\?{"url":"[^"]*rtt-monitor/manifest.json"}##g' | sed 's#\[,#[#')

                if [ "$NEW" = "[]" ] || [ -z "$NEW" ]; then
                    sed -i '/^pluginManifests=/d' "$BBB_WEB_PROPS"
                    echo "pluginManifests=" >> "$BBB_WEB_PROPS"
                else
                    sed -i "s|^pluginManifests=.*|pluginManifests=$NEW|" "$BBB_WEB_PROPS"
                fi
                echo "bbb-plugin-rtt-monitor: removed manifest from bbb-web.properties"
            fi
        fi
        ;;
esac

# On purge only, undo the lastEntriesCap key this package may have added.
# (remove keeps config; purge reverts it.) yq's del is a no-op if absent.
case "$1" in
    purge)
        HTML5_YML=/etc/bigbluebutton/bbb-html5.yml
        if [ -f "$HTML5_YML" ] && command -v yq >/dev/null 2>&1; then
            yq eval -i 'del(.public.stats.lastEntriesCap)' "$HTML5_YML"
            echo "bbb-plugin-rtt-monitor: removed public.stats.lastEntriesCap from $HTML5_YML"
        fi
        ;;
esac

#DEBHELPER#
